FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PARSER_DATA_DIR=/data

WORKDIR /app

RUN groupadd --system abred && useradd --system --gid abred --home /app abred

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

RUN mkdir -p /data && chown -R abred:abred /data /app
USER abred

EXPOSE 8081
VOLUME ["/data"]

CMD ["abred-parser-server", "serve"]
