# Required. Generate, for example, with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PARSER_API_TOKEN=

# Bind to 0.0.0.0 only behind a firewall/private network/reverse proxy.
PARSER_BIND_ADDRESS=127.0.0.1
PARSER_PUBLIC_PORT=8081
PARSER_SCHEDULER_ENABLED=true

# Immutable feed ZIPs are retained for four days, then removed automatically.
PARSER_FEED_RETENTION_HOURS=96

# Producer schedules are UTC. Uknig and Audiopolka run hourly; RuTracker every 2 hours.
AUDIOPOLKA_BACKFILL_PAGES=5
AUDIOPOLKA_SCHEDULE_MINUTE=17
UKNIG_BACKFILL_PAGES=20
UKNIG_SCHEDULE_MINUTE=7

# RuTracker production transport.
RUTRACKER_WORKER_URL=
RUTRACKER_WORKER_TOKEN=
RUTRACKER_WORKER_TOKEN_HEADER=X-Proxy-Token
RUTRACKER_WORKER_MODE=mirror
RUTRACKER_FORUMS=
RUTRACKER_SCHEDULE_MINUTE=47
RUTRACKER_SCHEDULE_EVERY_HOURS=2
RUTRACKER_TORRSERVER_ENRICH=true
TORRSERVER_URL=
TORRSERVER_URL_2=
TORRSERVER_USERNAME=
TORRSERVER_PASSWORD=
# One successful metadata result is enough. Two TorrServers are a parallel pool/failover pair.
TORRSERVER_REPLAY_SUCCESSES=1

# Telegram Ops Bot (optional Compose profile "telegram").
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_PARSER_URL=http://parser-server:8081
# Backend API address reachable from the parser server.
TELEGRAM_BACKEND_URL=http://<backend-address>:8000
# Dedicated 32+ character secret shared only by parser bot and backend ops API.
# Do not reuse PARSER_API_TOKEN or ADMIN_TOKEN.
TELEGRAM_BACKEND_TOKEN=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_REQUEST_TIMEOUT_SECONDS=30
TELEGRAM_LOG_LEVEL=INFO
